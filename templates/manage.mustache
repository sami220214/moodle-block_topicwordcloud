    @template block_topicwordcloud/manage
    Render management controls and optional pending moderation table.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-action, data-word

    Context variables required for this template:
    * heading, resetcloud, showpendingtable, pendingheading and block_topicwordcloud/word_table context variables

    Example context (json):
    {
        "heading": "Manage",
        "resetcloud": "Reset",
        "showpendingtable": true,
        "pendingheading": "Pending",
        "pendingtable": {"hasrows": false}
    }
}}
<h4 class="block-topicwordcloud__sectiontitle">{{heading}}</h4>
<div class="block-topicwordcloud__toolbar">
    <button type="button" class="btn btn-outline-danger" data-action="reset">{{resetcloud}}</button>
</div>
{{#showpendingtable}}
    <h4 class="block-topicwordcloud__sectiontitle">{{pendingheading}}</h4>
    {{#pendingtable}}
        {{> block_topicwordcloud/word_table }}
    {{/pendingtable}}
{{/showpendingtable}}