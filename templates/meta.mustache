    @template block_topicwordcloud/meta
    Render word cloud summary chips.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * responseslabel, responses, responderslabel, responders, uniquewordslabel, uniquewords,
      showpending, pendinglabel, pending, remainingwordslabel, remainingwords

    Example context (json):
    {
        "responseslabel": "Responses",
        "responses": 3,
        "responderslabel": "Responders",
        "responders": 2,
        "uniquewordslabel": "Unique words",
        "uniquewords": 3,
        "showpending": true,
        "pendinglabel": "Pending",
        "pending": 1,
        "remainingwordslabel": "Remaining words",
        "remainingwords": 7
    }
}}
<div class="block-topicwordcloud__chips">
    <span class="block-topicwordcloud__chip"><strong>{{responseslabel}}:</strong> {{responses}}</span>
    <span class="block-topicwordcloud__chip"><strong>{{responderslabel}}:</strong> {{responders}}</span>
    <span class="block-topicwordcloud__chip"><strong>{{uniquewordslabel}}:</strong> {{uniquewords}}</span>
    {{#showpending}}
        <span class="block-topicwordcloud__chip"><strong>{{pendinglabel}}:</strong> {{pending}}</span>
    {{/showpending}}
    <span class="block-topicwordcloud__chip"><strong>{{remainingwordslabel}}:</strong> {{remainingwords}}</span>
</div>