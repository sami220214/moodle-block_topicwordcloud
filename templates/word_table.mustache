    @template block_topicwordcloud/word_table
    Render word analytics or moderation rows.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-action, data-word

    Context variables required for this template:
    * hasrows, rows, emptytext, wordcolumn, countcolumn, userscolumn, showactions, actioncolumn

    Example context (json):
    {
        "hasrows": true,
        "wordcolumn": "Word",
        "countcolumn": "Count",
        "userscolumn": "Users",
        "showactions": true,
        "actioncolumn": "Action",
        "rows": [{"word": "Moodle", "count": 2, "userdisplay": "2"}]
    }
}}
{{#hasrows}}
    <div class="table-responsive">
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>{{wordcolumn}}</th>
                    <th>{{countcolumn}}</th>
                    <th>{{userscolumn}}</th>
                    {{#showactions}}
                        <th>{{actioncolumn}}</th>
                    {{/showactions}}
                </tr>
            </thead>
            <tbody>
                {{#rows}}
                    <tr>
                        <td>{{word}}</td>
                        <td>{{count}}</td>
                        <td>{{userdisplay}}</td>
                        {{#showactions}}
                            <td class="block-topicwordcloud__actions">
                                {{#showapprove}}
                                    <button type="button" class="btn btn-sm btn-secondary" data-action="approveword" data-word="{{normalizedword}}">{{approveword}}</button>
                                {{/showapprove}}
                                <button type="button" class="btn btn-sm btn-outline-danger" data-action="deleteword" data-word="{{normalizedword}}">{{deleteword}}</button>
                            </td>
                        {{/showactions}}
                    </tr>
                {{/rows}}
            </tbody>
        </table>
    </div>
{{/hasrows}}
{{^hasrows}}
    <p class="block-topicwordcloud__empty">{{emptytext}}</p>
{{/hasrows}}